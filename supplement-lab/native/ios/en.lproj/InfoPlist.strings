/* English – texts for system dialogs (override the values from Info.plist) */

/* Name below the app icon */
"CFBundleDisplayName" = "Kolbi";

/* Only needed if the Apple Health plugin (capacitor-supp-health) is enabled */
"NSHealthShareUsageDescription" = "Kolbi only reads your sleep duration and HRV from Apple Health to show them next to your check-ins. The data stays on your device and is never uploaded.";

/* Camera: only to read the barcode (add a supplement by barcode) */
