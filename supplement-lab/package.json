    "capacitor-supp-health": "file:./packages/capacitor-supp-health",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/node": "^20",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5",
    "vite": "^8.3.1"
  }
