<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Kein System-Backup: Kolbi-Daten (Einnahmen, Notizen, Werte) bleiben nur auf diesem Gerät.
         allowBackup=false greift bis Android 11; ab Android 12 schließen dataExtractionRules auch
         Cloud-Backup UND Geräte-Übertragung aus; fullBackupContent schließt für ältere Geräte alles aus.
         tools:replace: falls eine Bibliothek andere Werte mitbringt, gilt die App. -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:replace="android:allowBackup,android:fullBackupContent,android:dataExtractionRules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:screenOrientation="portrait"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Erinnerungen (lokale Benachrichtigungen): ab Android 13 fragt die App einmal nach Erlaubnis.
         Kommt auch über @capacitor/local-notifications, hier zur Klarheit ausdrücklich. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Bewusst ENTFERNT (Merge-Regel, die Bibliotheken bringen sie sonst mit):
         · SCHEDULE_EXACT_ALARM (@capacitor/local-notifications): Erinnerungen laufen ungenau
           (isExactNotification: false in src/native.ts) – exakte Wecker braucht Kolbi nicht, und Play
           fragt bei exakten Alarmen nach dem Zweck.
         · AD_ID (RevenueCat → play-services-ads-identifier): Kolbi nutzt keine Werbe-ID
           (Datenschutz: keine Geräte-IDs). Ohne die Berechtigung liefert Android nur Nullen.
         Der Android-Workflow prüft das gemergte Manifest und bricht ab, falls sie wieder auftauchen. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" tools:node="remove" />
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
</manifest>
